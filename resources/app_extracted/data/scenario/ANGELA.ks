[tb_start_text mode=1 ]
#ZACK
Okay, girls...[p]
Let's pretend nothing happened....[p]
#TINETTA
You'll have to excuse us, Professor...[p]
We didn't know anyone was coming to this office...[p]
#SALLY
It's true...[p]
This classroom is always empty....[p]
[_tb_end_text]

[tb_start_tyrano_code]
[endif]
[tb_start_tyrano_code]
