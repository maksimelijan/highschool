[tb_start_text mode=1 ]
#ILARY
Sarai tu ad essere umiliata oggi!!![p]
#ZACK
(Accidenti... Ilary sembra davvero determinata...)[p]
(Ma Potty è una nuotatrice agonista di altissimo livello...)[p]
(Si capisce già al primo sguardo che ha una marcia in più)[p]
(Rimarrò a guardare questa sfida... E questi bei culi!!!)[p]
[_tb_end_text]

[tb_start_tyrano_code]
[endif]
[_tb_end_tyrano_code]

[tb_start_tyrano_code]
[if exp="f.Lingua>0 && f.Lingua!=3"]
