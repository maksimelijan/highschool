#POTTY
E va bene...[p]
Facciamolo...[p]
Ma io ti avevo avvertita![p]
Poi non venire a piangere da me!!![p]
[_tb_end_text]

[tb_start_tyrano_code]
[endif]
[_tb_end_tyrano_code]

[tb_start_tyrano_code]
[if exp="f.Lingua>0 && f.Lingua!=3"]
[_tb_end_tyrano_code]

[tb_start_text mode=1 ]
