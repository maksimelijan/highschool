[_tb_system_call storage=system/_006_CORTILE_HUB.ks]

[cm  ]
[tb_ptext_hide  time="0"  ]
[tb_image_hide  time="0"  ]
[bg  time="1000"  method="crossfade"  storage="LOCATIONS_SCUOLA/Cortile.jpg"  ]
[tb_start_tyrano_code]
[if exp="f.Cortile<1"]
[_tb_end_tyrano_code]

[tb_eval  exp="f.Cortile=1"  name="Cortile"  cmd="="  op="t"  val="1"  val_2="undefined"  ]
[tb_show_message_window  ]
[tb_start_tyrano_code]
[if exp="f.Lingua==0"]
[_tb_end_tyrano_code]

[tb_start_text mode=1 ]
#ZACK
Una giornata così soleggiata...[p]
E nemmeno uno studente in cortile a sprecare tempo...[p]
Sarebbe stata la scuola ideale per un nerd come me! EH EH EH!![p]
[_tb_end_text]

[tb_start_tyrano_code]
[endif]
[_tb_end_tyrano_code]

[tb_start_tyrano_code]
[if exp="f.Lingua>0"]
[_tb_end_tyrano_code]

[tb_start_text mode=1 ]
#ZACK
Such a sunny day....[p]
And not a single student on the courtyard wasting time....[p]
It would have been the ideal school for a nerd like me! EH EH EH!!![p]
[_tb_end_text]

[tb_start_tyrano_code]
[endif]
[_tb_end_tyrano_code]

