[ptext layer=1 page=fore text=&f.Soldi size=16 x=100 y=10 color=yellow bold=true ]
[_tb_end_tyrano_code]

[tb_ptext_show  x="90"  y="10"  size="15"  color="0xfff705"  time="0"  text="$"  face="Sunday&nbsp;Best"  anim="false"  edge="undefined"  shadow="undefined"  ]
[tb_image_show  time="0"  storage="default/Energia.png"  width="100"  height="100"  y="100"  ]
[tb_start_tyrano_code]
[ptext layer=1 page=fore text=&f.Energia size=16 x=100 y=110 color=yellow bold=true ]
[_tb_end_tyrano_code]

[tb_ptext_show  x="85"  y="110"  size="15"  color="0xfff705"  time="0"  text="%"  face="Sunday&nbsp;Best"  anim="false"  edge="undefined"  shadow="undefined"  ]
[button  storage="003_SERA_HUB.ks"  target=""  graphic="Icone_Gioco/Ora.png"  width="100"  height="100"  x=""  y="200"  _clickable_img=""  name="img_6"  ]
[button  storage="005_MAPPA_SCUOLA.ks"  target=""  graphic="Icone_Gioco/Mappa.png"  width="100"  height="100"  x="0"  y="300"  _clickable_img=""  name="img_7"  ]
[button  storage="002_POMERIGGIO_HUB.ks"  target="*Pranzo"  graphic="Icone_Gioco/Carne.png"  width="100"  height="100"  y="400"  ]
[button  storage="GUIDA.ks"  target=""  graphic="Icone_Gioco/Elenco.png"  width="100"  height="100"  y="500"  name="img_12"  ]
[tb_ptext_show  x="974"  y="5"  size="40"  color="0xfa8805"  time="1000"  face="animeace2_reg"  text="AFTERNOON"  edge="0x000000"  shadow="undefined"  anim="true"  fadeout="false"  wait="false"  in_effect="swing"  out_effect="fadeOut"  ]
[s  ]
*Pranzo

[cm  ]
[tb_ptext_hide  time="0"  ]
[tb_image_hide  time="0"  ]
[tb_hide_message_window  ]
[bg  time="1000"  method="crossfade"  storage="DI_SERVIZIO/Mensa_Pranzo.jpg"  ]
[tb_eval  exp="f.Soldi-=25"  name="Soldi"  cmd="-="  op="t"  val="25"  val_2="undefined"  ]
[tb_eval  exp="f.Temp=Math.floor(Math.random()*(17-9+1)+9)"  name="Temp"  cmd="="  op="r"  val="9"  val_2="17"  ]
[tb_eval  exp="f.Energia+=f.Temp"  name="Energia"  cmd="+="  op="h"  val="Temp"  val_2="undefined"  ]
[tb_start_tyrano_code]
[if exp="f.Energia>99"]
[_tb_end_tyrano_code]

[tb_eval  exp="f.Energia=99"  name="Energia"  cmd="="  op="t"  val="99"  ]
[tb_start_tyrano_code]
[endif]
[_tb_end_tyrano_code]

[l  ]
[jump  storage="002_POMERIGGIO_HUB.ks"  target="*Back"  ]
