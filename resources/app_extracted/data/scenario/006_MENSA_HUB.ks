[_tb_end_tyrano_code]

[tb_eval  exp="f.Mensa=1"  name="Mensa"  cmd="="  op="t"  val="1"  val_2="undefined"  ]
[tb_show_message_window  ]
[tb_start_tyrano_code]
[if exp="f.Lingua==0"]
[_tb_end_tyrano_code]

[tb_start_text mode=1 ]
#ZACK
La mensa...[p]
Da quello che ho visto in giro, qui serviranno come minimo ostriche e caviale![p]
EH EH EH![p]
[_tb_end_text]

[tb_start_tyrano_code]
[endif]
[_tb_end_tyrano_code]

[tb_start_tyrano_code]
[if exp="f.Lingua==3"]
[_tb_end_tyrano_code]

[tb_start_text mode=1 ]
#ZACK
Столовая...[p]
Судя по тому, что я здесь видел, подавать будут как минимум устриц и икру![p]
Хе-хе-хе![p]
[_tb_end_text]

[tb_start_tyrano_code]
[endif]
[_tb_end_tyrano_code]

[tb_start_tyrano_code]
[if exp="f.Lingua>0 && f.Lingua!=3"]
[_tb_end_tyrano_code]

[tb_start_text mode=1 ]
#ZACK
The canteen...[p]
From what I've seen around here, they'll be serving oysters and caviar at the very least![p]
EH EH EH![p]
[_tb_end_text]

[tb_start_tyrano_code]
[endif]
[_tb_end_tyrano_code]

