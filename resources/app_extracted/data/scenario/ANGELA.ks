[tb_start_text mode=1 ]
#ZACK
Ok, ragazze...[p]
Facciamo finta che non sia successo niente...[p]
#TINETTA
Lei ci deve scusare, professore...[p]
Non sapevamo che sarebbe venuto qualcuno in questo ufficio...[p]
#SALLY
E' vero...[p]
Questa aula è sempre vuota...[p]
[_tb_end_text]

[tb_start_tyrano_code]
[endif]
[_tb_end_tyrano_code]

